# Krishi Bazaar — Environment Configuration Example
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
PORT=8000

# Set true when the site is served over HTTPS (production)
SESSION_HTTPS_ONLY=False

# ------------------------------------------------------------------------------
# Gmail SMTP: Send Real OTPs to Your Inbox
# ------------------------------------------------------------------------------
# STEP 1: Enable 2-Step Verification in Google Account (myaccount.google.com/security)
# STEP 2: Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# STEP 3: Enter your Gmail address and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Krishi Bazaar <no-reply@krishibazaar.local>

# ------------------------------------------------------------------------------
# Google OAuth 2.0 (for "Continue with Google")
# ------------------------------------------------------------------------------
# Set your Google Cloud OAuth Client ID and Secret below (Optional):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
